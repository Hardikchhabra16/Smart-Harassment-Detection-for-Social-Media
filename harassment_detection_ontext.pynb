        "        (\"Pleasantly surprised by this\", 0),\n",
        "        (\"I will expose you\", 1),\n",
        "        (\"Happy anniversary\", 0),\n",
        "        (\"You're a rotten person\", 1),\n",
        "        (\"Thanks for the advice\", 0),\n",
        "        (\"You are a worthless excuse for a human\", 1),\n",
        "        (\"That was exactly right\", 0),\n",
        "        (\"I hate your guts\", 1),\n",
        "        (\"Congrats Well deserved\", 0),\n",
        "        (\"You're a disgusting creature\", 1),\n",
        "        (\"Thanks appreciated\", 0),\n",
        "        (\"You're a menace to society\", 1),\n",
        "        (\"Best of luck in your new role\", 0),\n",
        "        (\"You should be ashamed of yourself\", 1),\n",
        "        (\"I'm grateful for your support\", 0),\n",
        "        (\"You're a horrible excuse for a friend\", 1),\n",
        "        (\"Well communicated\", 0),\n",
        "        (\"I will make sure you regret this\", 1),\n",
        "        (\"Enjoy your lunch\", 0),\n",
        "        (\"I hope you disappear forever\", 1),\n",
        "        (\"Thanks for the detailed report\", 0),\n",
        "        (\"You're a terrible human\", 1),\n",
        "        (\"Nice initiative\", 0),\n",
        "        (\"You're the scum of the earth\", 1),\n",
        "        (\"That helped so much\", 0),\n",
        "        (\"I will destroy your reputation\", 1),\n",
        "        (\"Congratulations on the wedding\", 0),\n",
        "        (\"You're a pathetic little man\", 1),\n",
        "        (\"Thanks for the inspiration\", 0),\n",
        "        (\"You are a spiteful person\", 1),\n",
        "        (\"Lovely to see these updates\", 0),\n",
        "        (\"You're a fraud\", 1),\n",
        "        (\"I appreciate your dedication\", 0),\n",
        "        (\"You're venomous and cruel\", 1),\n",
        "        (\"Thanks for the resource links\", 0),\n",
        "        (\"You're an embarrassment to your family\", 1),\n",
        "        (\"This made my day\", 0),\n",
        "        (\"You're a pathetic excuse for existence\", 1),\n",
        "        (\"Very informative post\", 0),\n",
        "        (\"I will make you pay dearly\", 1),\n",
        "        (\"Warm congratulations\", 0),\n",
        "        (\"You're an untrustworthy liar\", 1),\n",
        "        (\"Thanks for the warm welcome\", 0),\n",
        "        (\"You're a disgrace and a fraud\", 1),\n",
        "        (\"Appreciate your quick turnaround\", 0),\n",
        "        (\"You should go and hide\", 1),\n",
        "        (\"That was exactly what we needed\", 0),\n",
        "        (\"You're a liar and a cheat\", 1),\n",
        "        (\"Thanks for your time and patience\", 0),\n",
        "        (\"You are looking pretty\",0),\n",
        "        (\"I love you\",0),\n",
        "        (\"You are looking handsome\",0),\n",
        "        (\"You are as ugly as your mom\",1),\n",
        "        (\"Go to hell\",1),\n",
        "        (\"You look beautiful\",0,),\n",
        "    ]\n",
        "\n",
        "    # Split texts and labels\n",
        "    texts, labels = zip(*data)\n",
        "\n",
        "    # -----------------------\n",
        "    # Leveling / balancing the dataset\n",
        "    # -----------------------\n",
        "    df = pd.DataFrame({'text': texts, 'label': labels})\n",
        "    df_harassment = df[df['label'] == 1]\n",
        "    df_safe = df[df['label'] == 0]\n",
        "\n",
        "    if len(df_harassment) > len(df_safe):\n",
        "        df_safe = resample(df_safe, replace=True, n_samples=len(df_harassment), random_state=42)\n",
        "    else:\n",
        "        df_harassment = resample(df_harassment, replace=True, n_samples=len(df_safe), random_state=42)\n",
        "\n",
        "    df_balanced = pd.concat([df_harassment, df_safe])\n",
        "    texts = df_balanced['text'].tolist()\n",
        "    labels = df_balanced['label'].tolist()\n",
        "\n",
        "    X_train, X_test, y_train, y_test = train_test_split(texts, labels, test_size=0.2, random_state=42)\n",
        "\n",
        "    pipeline = Pipeline([\n",
        "        ('tfidf', TfidfVectorizer()),\n",
        "        ('clf', LogisticRegression())\n",
        "    ])\n",
        "\n",
        "    pipeline.fit(X_train, y_train)\n",
        "    y_pred = pipeline.predict(X_test)\n",
        "\n",
        "    accuracy = accuracy_score(y_test, y_pred)\n",
        "    f1 = f1_score(y_test, y_pred)\n",
        "\n",
        "    st.info(f\"Model trained on {len(X_train)} samples. Test Accuracy: {accuracy:.2f}, F1-Score: {f1:.2f}\")\n",
        "    return pipeline\n",
        "\n",
        "# -----------------------\n",
        "# Streamlit UI\n",
        "# -----------------------\n",
        "def main():\n",
        "    st.title(\"🛡️ ZeroTox: The Digital Frontier's Guard \")\n",
        "    st.write(\"Type any sentence and the model will classify it as **Safe** or **Harassment**\")\n",
        "\n",
        "    model = train_model()\n",
        "\n",
        "    user_input = st.text_area(\"Enter text here:\", height=100)\n",
        "    if st.button(\"Classify\"):\n",
        "        if user_input:\n",
        "            processed_input = preprocess_text(user_input)\n",
        "            prediction = model.predict([processed_input])[0]\n",
        "            probabilities = model.predict_proba([processed_input])[0]\n",
        "\n",
        "            if prediction == 0:\n",
        "                label = \"✅ Safe\"\n",
        "                confidence = probabilities[0] * 100\n",
        "            else:\n",
        "                label = \"🚨 Harassment\"\n",
        "                confidence = probabilities[1] * 100\n",
        "\n",
        "            st.success(f\"**Prediction:** {label}\")\n",
        "            st.success(f\"**Confidence:** {confidence:.2f}%\")\n",
        "        else:\n",
